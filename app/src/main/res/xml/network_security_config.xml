<?xml version="1.0" encoding="utf-8"?>
<!-- Open Cowork is self-hosted: allow plain HTTP for servers reached by IP/LAN
     and trust user-installed CAs for self-signed HTTPS setups. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
